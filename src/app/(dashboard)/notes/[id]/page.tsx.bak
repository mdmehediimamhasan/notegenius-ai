export default function SingleNotePage({ params }: { params: Promise<{ id: string }> }) {
  const { id } = use(params)
  const router = useRouter()
  const chatEndRef = useRef<HTMLDivElement>(null)
  const audioRef = useRef<HTMLAudioElement | null>(null)

  const [note, setNote] = useState<any>(null)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState('')
  const [generating, setGenerating] = useState(false)

  // Audio Playback State
  const [isPlaying, setIsPlaying] = useState(false)
  const [currentTime, setCurrentTime] = useState(0)
  const [duration, setDuration] = useState(0)

  // View mode: 'note' | 'quiz'
  const [viewMode, setViewMode] = useState<'note' | 'quiz'>('note')

  // Chat State
  const [chatMessages, setChatMessages] = useState<{ role: string; content: string }[]>([])
  const [chatInput, setChatInput] = useState('')
  const [chatLoading, setChatLoading] = useState(false)

  // Quiz State
  const [quizMode, setQuizMode] = useState<'selection' | 'mcq' | 'flashcard'>('selection')
  const [quizLoading, setQuizLoading] = useState(false)
  const [mcqQuestions, setMcqQuestions] = useState<MCQQuestion[]>([])
  const [flashcards, setFlashcards] = useState<Flashcard[]>([])
  const [currentQuestionIndex, setCurrentQuestionIndex] = useState(0)
  const [currentCardIndex, setCurrentCardIndex] = useState(0)
  const [selectedAnswer, setSelectedAnswer] = useState<number | null>(null)
  const [mcqScore, setMcqScore] = useState(0)
  const [quizComplete, setQuizComplete] = useState(false)

  const [isDesktop, setIsDesktop] = useState(true)
  useEffect(() => {
    const handleResize = () => setIsDesktop(window.innerWidth >= 1024)
    handleResize()
    window.addEventListener('resize', handleResize)
    return () => window.removeEventListener('resize', handleResize)
  }, [])

  useEffect(() => {
    fetchNote()
  }, [id])

  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' })
  }, [chatMessages])

  async function fetchNote() {
    try {
      const res = await fetch(`/api/notes/${id}`)
      if (!res.ok) throw new Error('Note not found')
      const data = await res.json()
      setNote(data.note)
      if (data.note.duration) setDuration(data.note.duration)
      if (data.note.chatMessages) {
        setChatMessages(data.note.chatMessages.map((m: any) => ({ role: m.role, content: cleanText(m.content) })))
      }
    } catch (err: any) {
      setError(err.message)
    } finally {
      setLoading(false)
    }
  }

  // Play/Pause original audio file
  const togglePlayAudio = () => {
    if (!audioRef.current) return
    if (isPlaying) {
      audioRef.current.pause()
      setIsPlaying(false)
    } else {
      audioRef.current.play().then(() => {
        setIsPlaying(true)
      }).catch(err => {
        console.error('Original audio playback error:', err)
        setIsPlaying(false)
      })
    }
  }

  const handleTimeUpdate = () => {
    if (audioRef.current) {
      setCurrentTime(audioRef.current.currentTime)
      if (audioRef.current.duration && !isNaN(audioRef.current.duration)) {
        setDuration(audioRef.current.duration)
      }
    }
  }

  const handleAudioEnded = () => {
    setIsPlaying(false)
    setCurrentTime(0)
  }

  const formatTime = (secs: number) => {
    if (isNaN(secs) || secs < 0) return '00:00'
    const m = Math.floor(secs / 60)
    const s = Math.floor(secs % 60)
    return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`
  }

  // For backward compatibility: check if generatedNotes is JSON or Markdown
  const isMarkdownNote = typeof note?.generatedNotes === 'string' && !note.generatedNotes.trim().startsWith('{')
  
  const parsedNotes: GeneratedNotes | null = note?.generatedNotes && !isMarkdownNote
    ? (typeof note.generatedNotes === 'string' ? JSON.parse(note.generatedNotes) : note.generatedNotes)
    : null

  async function handleGenerateNotes() {
    setGenerating(true)
    try {
      const res = await fetch('/api/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ noteId: id, transcript: note.transcript }),
      })
      if (!res.ok) {
        const data = await res.json()
        throw new Error(data.error || 'Failed to generate notes')
      }
      await fetchNote()
    } catch (err: any) {
      setError(err.message)
    } finally {
      setGenerating(false)
    }
  }

  async function sendChatMessage(e?: React.FormEvent, customMsg?: string) {
    if (e) e.preventDefault()
    const msgToSend = customMsg || chatInput
    if (!msgToSend.trim() || chatLoading) return

    const userMsg = cleanText(msgToSend.trim())
    setChatMessages((prev) => [...prev, { role: 'user', content: userMsg }])
    if (!customMsg) setChatInput('')
    setChatLoading(true)

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ noteId: id, message: userMsg }),
      })
      const data = await res.json()
      if (!res.ok) throw new Error(data.error || 'Chat failed')
      setChatMessages((prev) => [...prev, { role: 'assistant', content: cleanText(data.message.content) }])
    } catch (err: any) {
      setChatMessages((prev) => [...prev, { role: 'assistant', content: `Error: ${err.message}` }])
    } finally {
      setChatLoading(false)
    }
  }

  async function handleGenerateQuiz(type: 'mcq' | 'flashcard') {
    setQuizLoading(true)
    setQuizMode(type)
    setViewMode('quiz')
    try {
      const res = await fetch('/api/quiz', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ noteId: id, type }),
      })
      const data = await res.json()
      if (!res.ok) throw new Error(data.error || 'Quiz generation failed')

      if (type === 'mcq') {
        setMcqQuestions(data.quiz.questions)
        setCurrentQuestionIndex(0)
        setSelectedAnswer(null)
        setMcqScore(0)
        setQuizComplete(false)
      } else {
        setFlashcards(data.quiz.questions)
        setCurrentCardIndex(0)
      }
    } catch (err: any) {
      setError(err.message)
      setQuizMode('selection')
    } finally {
      setQuizLoading(false)
    }
  }

  function handleExportPDF() {
    if (!parsedNotes) return
    const doc = new jsPDF()
    let y = 20

    doc.setFontSize(20)
    doc.text(cleanText(note.title || 'Notes'), 20, y)
    y += 15

    if (parsedNotes.summary) {
      doc.setFontSize(12)
      doc.setTextColor(100)
      doc.text('Summary', 20, y)
      y += 8
      doc.setTextColor(0)
      doc.setFontSize(10)
      const summaryLines = doc.splitTextToSize(cleanText(parsedNotes.summary), 170)
      doc.text(summaryLines, 20, y)
      y += summaryLines.length * 5 + 10
    }

    if (parsedNotes.keyPoints) {
      doc.setFontSize(12)
      doc.setTextColor(100)
      doc.text('Key Points', 20, y)
      y += 8
      doc.setTextColor(0)
      doc.setFontSize(10)
      parsedNotes.keyPoints.forEach((point) => {
        if (y > 270) { doc.addPage(); y = 20 }
        const lines = doc.splitTextToSize(`• ${cleanText(point)}`, 170)
        doc.text(lines, 20, y)
        y += lines.length * 5 + 3
      })
      y += 5
    }

    doc.save(`${cleanText(note.title || 'notes')}.pdf`)
  }

  function handleExportMD() {
    if (!parsedNotes) return
    let md = `# ${cleanText(note.title || 'Notes')}\n\n`
    
    if (isMarkdownNote) {
      md += note.generatedNotes
    } else if (parsedNotes) {
      if (parsedNotes.summary) {
        md += `## Summary\n${cleanText(parsedNotes.summary)}\n\n`
      }
      if (parsedNotes.keyPoints) {
        md += `## Key Points\n${parsedNotes.keyPoints.map((p) => `- ${cleanText(p)}`).join('\n')}\n\n`
      }
      if (parsedNotes.actionItems && parsedNotes.actionItems.length > 0) {
        md += `## Action Items\n${parsedNotes.actionItems.map((a) => `- [ ] ${cleanText(a)}`).join('\n')}\n\n`
      }
    }

    const blob = new Blob([md], { type: 'text/markdown' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = `${cleanText(note.title || 'notes')}.md`
    a.click()
    URL.revokeObjectURL(url)
  }

(false)

  // Quiz State
  const [quizMode, setQuizMode] = useState<'selection' | 'mcq' | 'flashcard'>('selection')
  const [quizLoading, setQuizLoading] = useState(false)
  const [mcqQuestions, setMcqQuestions] = useState<MCQQuestion[]>([])
  const [flashcards, setFlashcards] = useState<Flashcard[]>([])
  const [currentQuestionIndex, setCurrentQuestionIndex] = useState(0)
  const [currentCardIndex, setCurrentCardIndex] = useState(0)
  const [selectedAnswer, setSelectedAnswer] = useState<number | null>(null)
  const [mcqScore, setMcqScore] = useState(0)
  const [quizComplete, setQuizComplete] = useState(false)

  const [isDesktop, setIsDesktop] = useState(true)
  useEffect(() => {
    const handleResize = () => setIsDesktop(window.innerWidth >= 1024)
    handleResize()
    window.addEventListener('resize', handleResize)
    return () => window.removeEventListener('resize', handleResize)
  }, [])

  useEffect(() => {
    fetchNote()
  }, [id])

  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' })
  }, [chatMessages])

  async function fetchNote() {
    try {
      const res = await fetch(`/api/notes/${id}`)
      if (!res.ok) throw new Error('Note not found')
      const data = await res.json()
      setNote(data.note)
      if (data.note.duration) setDuration(data.note.duration)
      if (data.note.chatMessages) {
        setChatMessages(data.note.chatMessages.map((m: any) => ({ role: m.role, content: cleanText(m.content) })))
      }
    } catch (err: any) {
      setError(err.message)
    } finally {
      setLoading(false)
    }
  }

  // Play/Pause original audio file
  const togglePlayAudio = () => {
    if (!audioRef.current) return
    if (isPlaying) {
      audioRef.current.pause()
      setIsPlaying(false)
    } else {
      audioRef.current.play().then(() => {
        setIsPlaying(true)
      }).catch(err => {
        console.error('Original audio playback error:', err)
        setIsPlaying(false)
      })
    }
  }

  const handleTimeUpdate = () => {
    if (audioRef.current) {
      setCurrentTime(audioRef.current.currentTime)
      if (audioRef.current.duration && !isNaN(audioRef.current.duration)) {
        setDuration(audioRef.current.duration)
      }
    }
  }

  const handleAudioEnded = () => {
    setIsPlaying(false)
    setCurrentTime(0)
  }

  const formatTime = (secs: number) => {
    if (isNaN(secs) || secs < 0) return '00:00'
    const m = Math.floor(secs / 60)
    const s = Math.floor(secs % 60)
    return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`
  }

  // For backward compatibility: check if generatedNotes is JSON or Markdown
  const isMarkdownNote = typeof note?.generatedNotes === 'string' && !note.generatedNotes.trim().startsWith('{')
  
  const parsedNotes: GeneratedNotes | null = note?.generatedNotes && !isMarkdownNote
    ? (typeof note.generatedNotes === 'string' ? JSON.parse(note.generatedNotes) : note.generatedNotes)
    : null

  async function handleGenerateNotes() {
    setGenerating(true)
    try {
      const res = await fetch('/api/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ noteId: id, transcript: note.transcript }),
      })
      if (!res.ok) {
        const data = await res.json()
        throw new Error(data.error || 'Failed to generate notes')
      }
      await fetchNote()
    } catch (err: any) {
      setError(err.message)
    } finally {
      setGenerating(false)
    }
  }

  async function sendChatMessage(e?: React.FormEvent, customMsg?: string) {
    if (e) e.preventDefault()
    const msgToSend = customMsg || chatInput
    if (!msgToSend.trim() || chatLoading) return

    const userMsg = cleanText(msgToSend.trim())
    setChatMessages((prev) => [...prev, { role: 'user', content: userMsg }])
    if (!customMsg) setChatInput('')
    setChatLoading(true)

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ noteId: id, message: userMsg }),
      })
      const data = await res.json()
      if (!res.ok) throw new Error(data.error || 'Chat failed')
      setChatMessages((prev) => [...prev, { role: 'assistant', content: cleanText(data.message.content) }])
    } catch (err: any) {
      setChatMessages((prev) => [...prev, { role: 'assistant', content: `Error: ${err.message}` }])
    } finally {
      setChatLoading(false)
    }
  }

  async function handleGenerateQuiz(type: 'mcq' | 'flashcard') {
    setQuizLoading(true)
    setQuizMode(type)
    setViewMode('quiz')
    try {
      const res = await fetch('/api/quiz', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ noteId: id, type }),
      })
      const data = await res.json()
      if (!res.ok) throw new Error(data.error || 'Quiz generation failed')

      if (type === 'mcq') {
        setMcqQuestions(data.quiz.questions)
        setCurrentQuestionIndex(0)
        setSelectedAnswer(null)
        setMcqScore(0)
        setQuizComplete(false)
      } else {
        setFlashcards(data.quiz.questions)
        setCurrentCardIndex(0)
      }
    } catch (err: any) {
      setError(err.message)
      setQuizMode('selection')
    } finally {
      setQuizLoading(false)
    }
  }

  function handleExportPDF() {
    if (!parsedNotes) return
    const doc = new jsPDF()
    let y = 20

    doc.setFontSize(20)
    doc.text(cleanText(note.title || 'Notes'), 20, y)
    y += 15

    if (parsedNotes.summary) {
      doc.setFontSize(12)
      doc.setTextColor(100)
      doc.text('Summary', 20, y)
      y += 8
      doc.setTextColor(0)
      doc.setFontSize(10)
      const summaryLines = doc.splitTextToSize(cleanText(parsedNotes.summary), 170)
      doc.text(summaryLines, 20, y)
      y += summaryLines.length * 5 + 10
    }

    if (parsedNotes.keyPoints) {
      doc.setFontSize(12)
      doc.setTextColor(100)
      doc.text('Key Points', 20, y)
      y += 8
      doc.setTextColor(0)
      doc.setFontSize(10)
      parsedNotes.keyPoints.forEach((point) => {
        if (y > 270) { doc.addPage(); y = 20 }
        const lines = doc.splitTextToSize(`• ${cleanText(point)}`, 170)
        doc.text(lines, 20, y)
        y += lines.length * 5 + 3
      })
      y += 5
    }

    doc.save(`${cleanText(note.title || 'notes')}.pdf`)
  }

  function handleExportMD() {
    if (!parsedNotes) return
    let md = `# ${cleanText(note.title || 'Notes')}\n\n`
    
    if (isMarkdownNote) {
      md += note.generatedNotes
    } else if (parsedNotes) {
      if (parsedNotes.summary) {
        md += `## Summary\n${cleanText(parsedNotes.summary)}\n\n`
      }
      if (parsedNotes.keyPoints) {
        md += `## Key Points\n${parsedNotes.keyPoints.map((p) => `- ${cleanText(p)}`).join('\n')}\n\n`
      }
      if (parsedNotes.actionItems && parsedNotes.actionItems.length > 0) {
        md += `## Action Items\n${parsedNotes.actionItems.map((a) => `- [ ] ${cleanText(a)}`).join('\n')}\n\n`
      }
    }

    const blob = new Blob([md], { type: 'text/markdown' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = `${cleanText(note.title || 'notes')}.md`
    a.click()
    URL.revokeObjectURL(url)
  }

  const renderFinalNote = () => (
    <div className="h-full overflow-y-auto custom-scrollbar pr-2">
      {/* 3. FINAL CLEAN WELL-STRUCTURED NOTE SECTION (Generated ONLY from transcribed text) */}
            <CollapsibleSection
              title="Final Structured Note"
              icon={Icons.fileText}
              defaultExpanded={true}
              badge="AI Generated"
              className="shadow-[0_8px_30px_rgba(0,0,0,0.4)]"
            >
              {(parsedNotes || isMarkdownNote) ? (
                <div className="space-y-4">
                  {isMarkdownNote ? (
                    <div className="bg-white/[0.01] p-2 sm:p-4 rounded-2xl">
                      <MarkdownRenderer content={note.generatedNotes} />
                    </div>
                  ) : (
                    <div className="space-y-8 mt-4">
                      {/* Overview Paragraph */}
                      {parsedNotes?.summary && (
                        <div className="space-y-2">
                          <h3 className="text-base font-bold text-violet-300">Overview</h3>
                          <div className="text-sm text-slate-300 leading-relaxed font-light bg-white/[0.02] p-5 rounded-2xl border border-white/[0.04]">
                            {cleanText(parsedNotes.summary)}
                          </div>
                        </div>
                      )}

                      {/* Key Takeaways & Points */}
                      {parsedNotes?.keyPoints && parsedNotes.keyPoints.length > 0 && (
                        <div className="space-y-3">
                          <h3 className="text-base font-bold text-violet-300">Key Points & Takeaways</h3>
                          <ul className="space-y-2.5">
                            {parsedNotes.keyPoints.map((point, i) => (
                              <li key={i} className="flex items-start gap-3 text-sm text-slate-300 leading-relaxed">
                                <span className="w-1.5 h-1.5 rounded-full bg-violet-400 mt-2 shrink-0 shadow-[0_0_6px_rgba(139,92,246,0.8)]" />
                                <span>{cleanText(point)}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}

                      {/* Detailed Headings & Paragraphs */}
                      {parsedNotes?.detailedNotes && parsedNotes.detailedNotes.length > 0 && (
                        <div className="space-y-6 pt-2">
                          {parsedNotes.detailedNotes.map((sec, i) => (
                            <div key={i} className="space-y-2.5 bg-white/[0.01] p-5 rounded-2xl border border-white/[0.03]">
                              <h3 className="text-base font-semibold text-cyan-300">{cleanText(sec.heading)}</h3>
                              <p className="text-sm text-slate-300 leading-relaxed whitespace-pre-wrap">{cleanText(sec.content)}</p>
                            </div>
                          ))}
                        </div>
                      )}

                      {/* Action Items if applicable */}
                      {parsedNotes?.actionItems && parsedNotes.actionItems.length > 0 && (
                        <div className="space-y-3 pt-2">
                          <h3 className="text-base font-bold text-violet-300">Action Items</h3>
                          <ul className="space-y-2.5">
                            {parsedNotes.actionItems.map((item, i) => (
                              <li key={i} className="flex items-start gap-3 text-sm text-slate-300 leading-relaxed">
                                <span className="w-1.5 h-1.5 rounded-full bg-cyan-400 mt-2 shrink-0 shadow-[0_0_6px_rgba(6,182,212,0.8)]" />
                                <span>{cleanText(item)}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}

                      {/* Decisions Made if applicable */}
                      {parsedNotes?.decisionsMade && parsedNotes.decisionsMade.length > 0 && (
                        <div className="space-y-3 pt-2">
                          <h3 className="text-base font-bold text-violet-300">Decisions & Conclusion</h3>
                          <ul className="space-y-2.5">
                            {parsedNotes.decisionsMade.map((decision, i) => (
                              <li key={i} className="flex items-start gap-3 text-sm text-slate-300 leading-relaxed">
                                <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 mt-2 shrink-0 shadow-[0_0_6px_rgba(16,185,129,0.8)]" />
                                <span>{cleanText(decision)}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </div>
                  )}
                </div>
              ) : (
                <div className="text-center py-12 border border-dashed border-white/[0.08] rounded-2xl p-8 mt-4">
                  <div className="w-12 h-12 rounded-2xl bg-violet-500/10 text-violet-400 flex items-center justify-center mx-auto mb-3">
                    {Icons.sparkles}
                  </div>
                  <h3 className="text-base font-bold text-white mb-1">Generate Clean Note</h3>
                  <p className="text-xs text-slate-500 mb-6 max-w-sm mx-auto">
                    Click below to generate a clean, structured note from the transcribed text.
                  </p>
                  <button 
                    onClick={handleGenerateNotes} 
                    disabled={generating} 
                    className="btn-primary py-2.5 px-6 text-sm disabled:opacity-50"
                  >
                    <span>{generating ? 'Generating Note...' : '✨ Generate Note'}</span>
                  </button>
                </div>
              )}
            </CollapsibleSection>
    </div>
  )

  const renderTranscript = () => (
    <div className="h-full overflow-y-auto custom-scrollbar pr-2 flex flex-col gap-6">
      {/* 1. AUDIO PLAYER TOP CARD */}
            <div className="rounded-3xl border border-white/[0.08] bg-gradient-to-br from-[#0f0f2d]/90 via-[#0d0d26]/80 to-[#08081a]/90 backdrop-blur-2xl p-6 relative overflow-hidden shadow-[0_10px_40px_rgba(0,0,0,0.5)]">
              <div className="absolute top-0 right-0 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none" />

              {/* Card Header Row */}
              <div className="flex items-center justify-between mb-6 relative z-10">
                <div className="flex items-center gap-2">
                  <span className="text-base font-semibold text-white tracking-tight">{cleanText(note.title)}</span>
                </div>
                
                <div className="flex items-center gap-2">
                  <a 
                    href={audioUrlToPlay} 
                    download 
                    className="w-8 h-8 rounded-xl bg-white/[0.05] hover:bg-white/10 border border-white/[0.08] flex items-center justify-center text-slate-400 hover:text-white transition-colors"
                    title="Download Original Audio"
                  >
                    {Icons.download}
                  </a>
                  
                  <button 
                    onClick={handleGenerateNotes}
                    disabled={generating}
                    className="px-4 py-1.5 rounded-xl bg-gradient-to-r from-violet-600 to-cyan-600 hover:from-violet-500 hover:to-cyan-500 text-white font-bold text-xs shadow-[0_0_15px_rgba(139,92,246,0.3)] transition-all flex items-center gap-1.5 disabled:opacity-50"
                  >
                    <span>{Icons.sparkles}</span>
                    <span>{generating ? 'Generating Note...' : 'Regenerate Note'}</span>
                  </button>
                </div>
              </div>

              {/* Waveform Player Section */}
              <div className="bg-black/30 border border-white/[0.05] rounded-2xl p-5 relative z-10 space-y-3">
                <div className="flex items-center justify-between gap-4">
                  <span className="text-xs font-mono text-slate-400">{formatTime(currentTime)}</span>
                  
                  {/* Interactive Waveform Seeking Bar */}
                  <div 
                    className="flex-1 flex items-center justify-center gap-[3px] h-12 px-2 cursor-pointer"
                    onClick={(e) => {
                      if (!audioRef.current || !duration) return
                      const rect = e.currentTarget.getBoundingClientRect()
                      const clickX = e.clientX - rect.left
                      const newTime = (clickX / rect.width) * duration
                      audioRef.current.currentTime = newTime
                      setCurrentTime(newTime)
                    }}
                  >
                    {[12, 18, 28, 45, 30, 15, 25, 40, 60, 75, 90, 65, 50, 80, 95, 70, 40, 30, 55, 85, 100, 75, 50, 35, 60, 80, 45, 25, 15, 30, 50, 70, 40, 20, 10, 25, 45, 65, 30, 15, 8].map((h, i, arr) => {
                      const barRatio = i / arr.length
                      const isPlayed = barRatio <= progressRatio
                      return (
                        <div
                          key={i}
                          className={`w-[3px] rounded-full transition-all duration-300 ${
                            isPlayed 
                              ? 'bg-cyan-400 shadow-[0_0_8px_rgba(6,182,212,0.8)]' 
                              : 'bg-slate-700/60'
                          }`}
                          style={{ height: `${h}%` }}
                        />
                      )
                    })}
                  </div>

                  <span className="text-xs font-mono text-slate-400">
                    {formatTime(duration || 10)}
                  </span>
                </div>

                {/* Big Play / Pause Control Button */}
                <div className="flex justify-center items-center pt-1">
                  <button 
                    onClick={togglePlayAudio}
                    className="w-12 h-12 rounded-full bg-white text-[#060611] flex items-center justify-center hover:scale-105 active:scale-95 transition-all shadow-[0_0_25px_rgba(255,255,255,0.3)]"
                    title={isPlaying ? 'Pause Audio' : 'Play Original Audio'}
                  >
                    {isPlaying ? Icons.pause : Icons.play}
                  </button>
                </div>
              </div>
            </div>

            {/* 2. TRANSCRIBED TEXT CONTAINER (Displayed directly below audio player) */}
            <CollapsibleSection
              title="Transcribed Text (Speech-to-Text)"
              icon={Icons.waveform}
              defaultExpanded={false}
              className="border-cyan-500/20 shadow-[0_8px_30px_rgba(6,182,212,0.1)]"
              headerClassName="bg-gradient-to-r from-cyan-500/[0.04] to-transparent"
            >
              <div className="flex justify-end mb-3">
                <button 
                  onClick={() => navigator.clipboard.writeText(cleanText(note.transcript || ''))}
                  className="px-3 py-1 text-xs bg-white/[0.06] hover:bg-white/10 text-slate-300 rounded-lg transition-all border border-white/[0.08] flex items-center gap-1.5"
                >
                  📋 Copy Transcribed Text
                </button>
              </div>
              <div className="bg-black/30 p-4 rounded-2xl border border-white/[0.06] max-h-72 overflow-y-auto leading-relaxed text-xs text-slate-300 whitespace-pre-wrap font-sans">
                {cleanText(note.transcript || 'No transcribed speech text available.')}
              </div>
            </CollapsibleSection>
    </div>
  )

  const renderChatAssistant = () => (
    <div className="h-full overflow-hidden flex flex-col">
      {/* RIGHT 4 COLUMNS: AI CHAT ASSISTANT PANEL */}
          <div className="w-full h-full">
            <CollapsibleSection
              title="AI Chat Assistant"
              icon={Icons.bot}
              defaultExpanded={true}
              className="shadow-[0_10px_40px_rgba(0,0,0,0.5)] border-white/[0.08] bg-gradient-to-b from-[#0f0f2d]/95 via-[#0a0a1e]/95 to-[#080818]/95"
            >
              <div className="flex flex-col flex-1 h-full pt-4">
                {/* Chat Messages List */}
            <div className="flex-1 overflow-y-auto space-y-4 pr-1 scroll-smooth">
              {chatMessages.length === 0 && (
                <div className="text-center py-12 text-slate-500 text-xs">
                  <div className="w-10 h-10 rounded-full bg-violet-500/10 text-violet-400 flex items-center justify-center mx-auto mb-2">
                    {Icons.sparkles}
                  </div>
                  <p className="font-medium text-slate-400">Ask anything about this recording</p>
                  <p className="text-[11px] mt-1 text-slate-600">Get instant summary, action items or key insights</p>
                </div>
              )}

              {chatMessages.map((msg, idx) => (
                <div key={idx} className={`flex gap-2.5 ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                  {msg.role === 'assistant' && (
                    <div className="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 flex items-center justify-center text-[10px] shrink-0 mt-1">
                      {Icons.bot}
                    </div>
                  )}
                  
                  <div
                    className={`max-w-[85%] p-3.5 rounded-2xl leading-relaxed ${
                      msg.role === 'user'
                        ? 'bg-violet-600/80 text-white rounded-tr-none shadow-[0_4px_15px_rgba(139,92,246,0.3)] text-sm'
                        : 'bg-white/[0.05] text-slate-300 border border-white/[0.06] rounded-tl-none'
                    }`}
                  >
                    {msg.role === 'user' ? (
                      cleanText(msg.content)
                    ) : (
                      <MarkdownRenderer content={msg.content} compact={true} />
                    )}
                  </div>
                </div>
              ))}

              {chatLoading && (
                <div className="flex gap-2.5 justify-start">
                  <div className="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 flex items-center justify-center text-[10px] shrink-0 mt-1">
                    {Icons.bot}
                  </div>
                  <div className="p-3 rounded-2xl bg-white/[0.05] border border-white/[0.06] rounded-tl-none">
                    <div className="flex gap-1">
                      <span className="w-1.5 h-1.5 bg-violet-400 rounded-full animate-bounce" style={{ animationDelay: '0ms' }} />
                      <span className="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-bounce" style={{ animationDelay: '150ms' }} />
                      <span className="w-1.5 h-1.5 bg-violet-400 rounded-full animate-bounce" style={{ animationDelay: '300ms' }} />
                    </div>
                  </div>
                </div>
              )}

              <div ref={chatEndRef} />
            </div>

            {/* Quick Suggested Prompts */}
            <div className="pt-3 pb-2 space-y-1.5">
              {[
                'What are the key points in this audio?',
                'Summarize main action items',
                'What decisions were made?',
              ].map((suggestion, i) => (
                <button
                  key={i}
                  onClick={() => sendChatMessage(undefined, suggestion)}
                  className="w-full text-left px-3 py-1.5 rounded-xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.05] text-[11px] text-slate-400 hover:text-white transition-all truncate block"
                >
                  {suggestion}
                </button>
              ))}
            </div>

            {/* Bottom Chat Input Form */}
            <form onSubmit={(e) => sendChatMessage(e)} className="mt-2 pt-3 border-t border-white/[0.06]">
              <div className="bg-black/40 border border-white/[0.08] rounded-2xl p-2.5 flex items-center gap-2 focus-within:border-violet-500/40 transition-all">
                <button type="button" className="text-slate-500 hover:text-slate-300 p-1">
                  {Icons.paperclip}
                </button>
                <button type="button" className="text-slate-500 hover:text-slate-300 p-1">
                  {Icons.smile}
                </button>
                
                <input
                  type="text"
                  placeholder="Ask anything about this note..."
                  value={chatInput}
                  onChange={(e) => setChatInput(e.target.value)}
                  className="flex-1 bg-transparent text-xs text-white placeholder-slate-500 outline-none"
                />

                <button
                  type="submit"
                  disabled={!chatInput.trim() || chatLoading}
                  className="w-8 h-8 rounded-xl bg-violet-600 hover:bg-violet-500 text-white flex items-center justify-center transition-all disabled:opacity-40 shadow-[0_0_12px_rgba(139,92,246,0.4)] shrink-0"
                >
                  {Icons.send}
                </button>
              </div>
            </form>
              </div>
            </CollapsibleSection>
          </div>
    </div>
  )


  if (loading) {
    return (
      <div className="max-w-7xl mx-auto space-y-6 animate-pulse p-4">
        <div className="h-8 w-48 bg-white/5 rounded-lg" />
        <div className="h-44 w-full bg-white/5 rounded-3xl" />
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div className="lg:col-span-2 h-96 bg-white/5 rounded-3xl" />
          <div className="h-96 bg-white/5 rounded-3xl" />
        </div>
      </div>
    )
  }

  if (error && !note) {
    return (
      <div className="max-w-7xl mx-auto p-4">
        <div className="bg-red-500/10 border border-red-500/20 text-red-400 p-6 rounded-3xl text-center shadow-[0_0_20px_rgba(239,68,68,0.15)]">
          <div className="text-4xl mb-4">⚠️</div>
          <h3 className="text-xl font-bold mb-2">Failed to load note</h3>
          <p>{error}</p>
          <button 
            onClick={() => router.push('/dashboard')} 
            className="mt-6 px-6 py-2 bg-white/5 hover:bg-white/10 rounded-xl transition-all"
          >
            ← Back to Dashboard
          </button>
        </div>
      </div>
    )
  }

  if (!note) return null

  // Ensure progressRatio is safe
  const progressRatio = duration > 0 ? currentTime / duration : 0
  const audioUrlToPlay = note.audioUrl ? (note.audioUrl.startsWith('http') ? note.audioUrl : `/${note.audioUrl}`) : ''

  return (
    <div className="max-w-7xl mx-auto space-y-6 pb-20 relative">
      <div className="absolute top-0 right-0 w-96 h-96 bg-violet-500/10 rounded-full blur-3xl pointer-events-none" />
      <div className="absolute bottom-0 left-0 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none" />

      {/* TOP HEADER */}
      <div className="flex items-center justify-between bg-[#0a0a1e]/80 backdrop-blur-xl border border-white/[0.08] p-4 rounded-3xl sticky top-6 z-50 shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
        <div className="flex items-center gap-4">
          <button 
            onClick={() => router.push('/dashboard')}
            className="w-10 h-10 rounded-2xl bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.05] flex items-center justify-center text-slate-400 hover:text-white transition-all hover:scale-105 active:scale-95"
          >
            ←
          </button>
          
          <div className="flex items-center p-1 bg-black/40 rounded-2xl border border-white/[0.05]">
            <button
              onClick={() => setViewMode('note')}
              className={`px-5 py-2 rounded-xl text-sm font-medium transition-all duration-300 ${
                viewMode === 'note' 
                  ? 'bg-gradient-to-r from-violet-600 to-cyan-600 text-white shadow-[0_0_15px_rgba(139,92,246,0.3)]' 
                  : 'text-slate-400 hover:text-white hover:bg-white/[0.05]'
              }`}
            >
              Note Details
            </button>
            <button
              onClick={() => {
                if (!quizComplete && mcqQuestions.length === 0 && flashcards.length === 0) {
                  setViewMode('quiz')
                  setQuizMode('selection')
                } else {
                  setViewMode('quiz')
                }
              }}
              className={`px-5 py-2 rounded-xl text-sm font-medium transition-all duration-300 ${
                viewMode === 'quiz' 
                  ? 'bg-gradient-to-r from-violet-600 to-cyan-600 text-white shadow-[0_0_15px_rgba(139,92,246,0.3)]' 
                  : 'text-slate-400 hover:text-white hover:bg-white/[0.05]'
              }`}
            >
              Interactive Quiz
            </button>
          </div>
        </div>
        
        <div className="flex items-center gap-2">
          {viewMode === 'quiz' ? (
            <button 
              onClick={() => setViewMode('note')}
              className="px-4 py-2 text-xs bg-white/[0.04] text-slate-300 hover:text-white hover:bg-white/[0.08] border border-white/[0.08] rounded-xl transition-all font-medium"
            >
              ← Back to Notes
            </button>
          ) : (
            <button 
              onClick={() => handleGenerateQuiz('mcq')}
              className="px-3 py-1.5 text-xs bg-cyan-500/12 text-cyan-300 hover:bg-cyan-500/20 border border-cyan-500/20 rounded-xl transition-all font-medium flex items-center gap-1.5"
            >
              {Icons.quiz} Practice Quiz
            </button>
          )}

          {(parsedNotes || isMarkdownNote) && (
            <>
              <button 
                onClick={handleExportPDF} 
                className="px-3 py-1.5 text-xs bg-white/[0.04] text-slate-300 hover:text-white hover:bg-white/[0.08] border border-white/[0.08] rounded-xl transition-all font-medium flex items-center gap-1.5"
              >
                {Icons.pdf} PDF
              </button>
              <button 
                onClick={handleExportMD} 
                className="px-3 py-1.5 text-xs bg-white/[0.04] text-slate-300 hover:text-white hover:bg-white/[0.08] border border-white/[0.08] rounded-xl transition-all font-medium flex items-center gap-1.5"
              >
                {Icons.markdown} MD
              </button>
            </>
          )}
        </div>
      </div>

      {/* VIEW MODE: QUIZ */}
      {viewMode === 'quiz' && (
        <div className="rounded-3xl border border-white/[0.06] bg-[#0a0a1e]/80 backdrop-blur-xl p-8 animate-fade-in">
          {quizLoading ? (
            <div className="text-center py-16">
              <div className="w-12 h-12 border-2 border-violet-500/20 border-t-violet-500 rounded-full animate-spin mx-auto mb-4" />
              <p className="text-violet-300 text-sm font-medium animate-pulse">Generating interactive quiz...</p>
            </div>
          ) : (
            <div className="max-w-2xl mx-auto">
              {quizComplete ? (
                <div className="text-center py-10">
                  <div className="text-5xl mb-3">🎉</div>
                  <h3 className="text-2xl font-bold text-white mb-1">Quiz Completed!</h3>
                  <p className="text-lg text-violet-300 mb-6">Your Score: {mcqScore} / {mcqQuestions.length}</p>
                  <div className="flex justify-center gap-3">
                    <button 
                      onClick={() => { setCurrentQuestionIndex(0); setSelectedAnswer(null); setMcqScore(0); setQuizComplete(false) }} 
                      className="btn-secondary py-2.5 px-6 text-sm"
                    >
                      Retry Quiz
                    </button>
                    <button 
                      onClick={() => setViewMode('note')}
                      className="btn-primary py-2.5 px-6 text-sm"
                    >
                      Back to Notes
                    </button>
                  </div>
                </div>
              ) : mcqQuestions.length > 0 ? (
                <div className="space-y-8 animate-fade-in">
                  <div className="flex justify-between items-center pb-4 border-b border-white/[0.06]">
                    <h3 className="text-lg font-bold text-white flex items-center gap-2">
                      <span className="text-cyan-400">{Icons.quiz}</span>
                      Question {currentQuestionIndex + 1} <span className="text-slate-500 text-sm font-normal">of {mcqQuestions.length}</span>
                    </h3>
                    <div className="text-sm font-medium text-violet-300 bg-violet-500/10 px-3 py-1 rounded-lg">
                      Score: {mcqScore}
                    </div>
                  </div>

                  <p className="text-lg text-white leading-relaxed">
                    {cleanText(mcqQuestions[currentQuestionIndex].question)}
                  </p>

                  <div className="space-y-3">
                    {mcqQuestions[currentQuestionIndex].options.map((opt, i) => {
                      const isSelected = selectedAnswer === i
                      const isCorrect = i === mcqQuestions[currentQuestionIndex].correctAnswer
                      
                      let cardStyle = "bg-white/[0.02] border-white/[0.06] hover:bg-white/[0.05] hover:border-violet-500/30"
                      
                      if (selectedAnswer !== null) {
                        if (isCorrect) {
                          cardStyle = "bg-emerald-500/10 border-emerald-500/30 text-emerald-100"
                        } else if (isSelected) {
                          cardStyle = "bg-red-500/10 border-red-500/30 text-red-100"
                        } else {
                          cardStyle = "bg-white/[0.01] border-white/[0.03] opacity-50"
                        }
                      }

                      return (
                        <button
                          key={i}
                          onClick={() => {
                            if (selectedAnswer !== null) return
                            setSelectedAnswer(i)
                            if (i === mcqQuestions[currentQuestionIndex].correctAnswer) setMcqScore(prev => prev + 1)
                          }}
                          disabled={selectedAnswer !== null}
                          className={`w-full text-left p-4 rounded-xl border transition-all text-sm font-medium flex items-center justify-between ${cardStyle}`}
                        >
                          <span>{['A', 'B', 'C', 'D'][i]}. {cleanText(opt)}</span>
                          {selectedAnswer !== null && isCorrect && <span className="text-emerald-400 text-xs font-bold">Correct ✓</span>}
                          {selectedAnswer !== null && isSelected && !isCorrect && <span className="text-red-400 text-xs font-bold">Wrong ✗</span>}
                        </button>
                      )
                    })}
                  </div>

                  {selectedAnswer !== null && (
                    <div className="pt-4 border-t border-white/[0.06] flex justify-between items-center">
                      <p className="text-xs text-slate-400 italic max-w-md">{cleanText(mcqQuestions[currentQuestionIndex].explanation)}</p>
                      <button 
                        onClick={() => {
                          if (currentQuestionIndex < mcqQuestions.length - 1) {
                            setCurrentQuestionIndex(prev => prev + 1)
                            setSelectedAnswer(null)
                          } else {
                            setQuizComplete(true)
                          }
                        }} 
                        className="btn-primary py-2 px-5 text-xs"
                      >
                        <span>{currentQuestionIndex < mcqQuestions.length - 1 ? 'Next Question →' : 'See Results'}</span>
                      </button>
                    </div>
                  )}
                </div>
              ) : null}
            </div>
          )}
        </div>
      )}

      {/* VIEW MODE: MAIN NOTE & AI CHAT SIDE-BY-SIDE */}
      {viewMode === 'note' && (
        <div className="w-full animate-fade-in">
          {isDesktop ? (
            <div className="h-[calc(100vh-140px)] min-h-[700px] w-full border border-white/[0.05] rounded-3xl bg-[#080818]/40 p-1 shadow-2xl overflow-hidden backdrop-blur-3xl">
              <PanelGroup direction="horizontal" autoSaveId="note-genius-panels-v2">
                <Panel defaultSize={35} minSize={25} className="p-2 h-full">
                  {renderFinalNote()}
                </Panel>
                <ResizeHandle />
                <Panel defaultSize={35} minSize={25} className="p-2 h-full flex flex-col gap-6">
                  {renderTranscript()}
                </Panel>
                <ResizeHandle />
                <Panel defaultSize={30} minSize={20} className="p-2 h-full">
                  {renderChatAssistant()}
                </Panel>
              </PanelGroup>
            </div>
          ) : (
            <div className="flex flex-col gap-6">
              {renderFinalNote()}
              {renderTranscript()}
              {renderChatAssistant()}
            </div>
          )}
        </div>
      )}
    </div>
  )
}
