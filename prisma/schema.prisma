generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  hashedPassword     String?
  isAdmin            Boolean   @default(false)
  geminiApiKey       String?
  groqApiKey         String?
  speechmaticsApiKey String?
  mistralApiKey      String?
  openrouterApiKey   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  accounts           Account[]
  sessions           Session[]
  notes              Note[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Note {
  id                String        @id @default(cuid())
  userId            String
  title             String        @default("Untitled Note")
  sourceType        String        @default("audio")
  originalFileName  String?
  audioUrl          String?
  transcript        String?
  cleanedTranscript String?
  generatedNotes    String?
  summary           String?
  keyPoints         String?
  language          String        @default("en")
  duration          Float?
  status            String        @default("pending")
  transcribedBy     String?
  generatedBy       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessages      ChatMessage[]
  quizzes           Quiz[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  noteId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model Quiz {
  id        String   @id @default(cuid())
  noteId    String
  quizType  String   @default("mcq")
  questions String
  score     Int?
  totalQ    Int?
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}
